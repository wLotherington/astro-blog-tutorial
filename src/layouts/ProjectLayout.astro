---
import BaseLayout from './BaseLayout.astro';
const { frontmatter } = Astro.props;
---

<BaseLayout pageTitle={frontmatter.title} description={frontmatter.description}>
  <article>
    <h1>{frontmatter.title}</h1>
    <p class="article-meta">
      {frontmatter.date.getUTCFullYear()}
      {' · '}
      {frontmatter.description}
      {(frontmatter.repo || frontmatter.link) && (
        <span class="article-links">
          {frontmatter.link && <a href={frontmatter.link}>{frontmatter.linkLabel}</a>}
          {frontmatter.link && frontmatter.repo && ' · '}
          {frontmatter.repo && <a href={frontmatter.repo}>Source</a>}
        </span>
      )}
    </p>

    <style>
      .article-links {
        display: block;
        margin-top: 0.25rem;
      }
    </style>

    <slot />
  </article>
</BaseLayout>
