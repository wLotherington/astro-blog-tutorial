---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogPost from "../components/BlogPost.astro";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const allProjects = (await getCollection("projects"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const pinned = allProjects.find((project) => project.data.pinned);
const otherProjects = allProjects.filter((project) => !project.data.pinned);
---

<BaseLayout description="Will Lotherington — software engineer. Writing and projects.">
  <h1>Hi, I'm Will.</h1>
  <p>
    I'm a software engineer at Google. This is my corner of the internet —
    a place for writing, and for the projects I build on the side.
  </p>

  {pinned && (
    <section class="pinned">
      <p class="pinned-label">Pinned project</p>
      <h2><a href={`/projects/${pinned.id}/`}>{pinned.data.title}</a></h2>
      <p class="pinned-description">{pinned.data.description}</p>
      <p class="pinned-links">
        <a href={`/projects/${pinned.id}/`}>Read more</a>
        {pinned.data.link && <> · <a href={pinned.data.link}>Case study</a></>}
        {pinned.data.repo && <> · <a href={pinned.data.repo}>Source</a></>}
      </p>
    </section>
  )}

  <h2>Recent writing</h2>
  <ul class="item-list">
    {posts.map((post) => (
      <BlogPost url={`/posts/${post.id}/`} title={post.data.title} date={post.data.pubDate} />
    ))}
  </ul>
  <p><a href="/blog/">All posts →</a></p>

  <h2>More projects</h2>
  <ul class="item-list">
    {otherProjects.map((project) => (
      <li>
        <a href={`/projects/${project.id}/`}>{project.data.title}</a>
        <span class="muted">{project.data.description}</span>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .pinned {
    margin: 2.5rem 0;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--color-faint);
    border-radius: 8px;
  }

  .pinned-label {
    margin: 0 0 0.25rem;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-muted);
  }

  .pinned h2 {
    margin: 0 0 0.375rem;
  }

  .pinned h2 a {
    text-decoration: none;
  }

  .pinned h2 a:hover {
    text-decoration: underline;
  }

  .pinned-description {
    margin: 0 0 0.625rem;
  }

  .pinned-links {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }
</style>
