---
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle = "About";
---

<BaseLayout pageTitle={pageTitle} description="About Will Lotherington.">
  <h1>About</h1>

  <p>I'm Will Lotherington, a software engineer at Google.</p>

  <p>
    This site is where I write about software and share the projects I work on
    outside of my day job. It's intentionally simple: fast, static, and free of
    clutter, built with <a href="https://astro.build/">Astro</a>.
  </p>

  <p>
    If you'd like to get in touch, you can find me on
    <a href="https://github.com/wLotherington">GitHub</a> or email me at
    <a href="mailto:will@lotherington.me">will@lotherington.me</a>.
  </p>
</BaseLayout>
